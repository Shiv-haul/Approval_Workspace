<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Sign in · MMCL Approval Workspace</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <style>
    body { min-height: 100vh; display: flex; align-items: center; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); }
    .login-card { max-width: 460px; width: 100%; margin: auto; }
  </style>
</head>
<body>
<div class="container">
  <div class="login-card card shadow-lg border-0">
    <div class="card-body p-4">
      <div class="text-center mb-4">
        <h3 class="fw-bold mb-1">MESABI METALLICS</h3>
        <div class="text-muted small">Approval Workspace · Sign in</div>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger py-2"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" class="form-control form-control-lg" name="email" value="<%= email || '' %>"
                 placeholder="firstname.lastname@mesabimetallics.com" required autofocus>
        </div>
        <div class="mb-4">
          <label class="form-label">Password</label>
          <input type="password" class="form-control form-control-lg" name="password" required>
        </div>
        <button class="btn btn-primary btn-lg w-100">Sign in</button>
      </form>

      <hr class="my-4">
      <div class="small text-muted">
        <strong>Test accounts</strong> (password is <code>Test@123</code> for all):
        <ul class="ps-3 mb-0">
          <li><code>shivansh.sharma@mesabimetallics.com</code> &mdash; Indentor</li>
          <li><code>niranjan.shinde@mesabimetallics.com</code> &mdash; Verifier</li>
          <li><code>joe.broking@mesabimetallics.com</code> or <code>rizwan.m@mesabimetallics.com</code> &mdash; Approver (Project Head)</li>
          <li><code>anita.roy@mesabimetallics.com</code> &mdash; Project Team</li>
          <li><code>rahul.menon@mesabimetallics.com</code> &mdash; Purchase</li>
        </ul>
      </div>
    </div>
  </div>
</div>
</body>
</html>
